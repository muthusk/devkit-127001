# =============================================================================
# Temporal Local Dev Environment Configuration
# =============================================================================

# Temporal Server
TEMPORAL_VERSION=latest
TEMPORAL_UI_VERSION=latest
TEMPORAL_ADMIN_TOOLS_VERSION=latest
TEMPORAL_ADDRESS=temporal-server:7233
TEMPORAL_NAMESPACE=default

# Postgres
POSTGRES_VERSION=16
POSTGRES_USER=temporal
POSTGRES_PASSWORD=temporal
POSTGRES_DB=temporal
POSTGRES_PORT=5432

# Temporal Ports (host:container)
TEMPORAL_GRPC_PORT=7233
TEMPORAL_HTTP_PORT=7243
TEMPORAL_UI_PORT=8080

# Go Worker
GO_TASK_QUEUE=go-task-queue

# TypeScript Worker
TS_TASK_QUEUE=ts-task-queue
